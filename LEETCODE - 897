
class Solution {
public:
    TreeNode* increasingBST(TreeNode* root) {
        TreeNode dummy(0), *prev = &dummy;

        function<void(TreeNode*)> dfs = [&](TreeNode* node){
            if (!node) return;

            dfs(node -> left);

            node -> left = nullptr;
            prev -> right = node;
            prev = node;

            dfs(node -> right);

        };

        dfs(root);
        return dummy.right;
        
    }

    
};
